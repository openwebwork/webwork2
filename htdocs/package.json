		"bootstrap": "^5.3.9",
		"flatpickr": "^4.6.13",
		"iframe-resizer": "4.4.2",
		"jquery": "^4.1.0",
		"jquery-ui-dist": "^1.13.3",
		"luxon": "^3.7.2",
		"mathjax": "^4.1.3",
		"minisearch": "^7.2.0",
		"shortcut-buttons-flatpickr": "^0.4.0",
		"sortablejs": "^1.15.7"
	},
	"devDependencies": {
		"@openwebwork/prettier-plugin-mojolicious-html-template": "^0.0.4",
		"autoprefixer": "^10.7.0",
		"chokidar": "^6.0.0",
