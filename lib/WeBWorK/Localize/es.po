#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/CourseAdmin.pm:1155
msgid ""
"A directory already exists with the name %1. You must first delete this "
"existing course before you can unarchive."
msgstr "Ya existe un directorio con el nombre %1. Primero debes eliminar este curso existente antes de poder desarchivar."

#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/Instructor/Scoring.pm:97
#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/Instructor/ScoringDownload.pm:27
msgid ""
"A file name cannot begin with a dot, it cannot be empty, it cannot contain a "
"directory path component and only the characters -_.a-zA-Z0-9 and space are "
"allowed."
msgstr "Un nombre de archivo no puede comenzar con un punto, no puede estar vacío, no puede contener un componente de ruta de directorio y solo se permiten los caracteres -_.a-zA-Z0-9 y el espacio."

#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/Instructor/FileManager.pm:1106
