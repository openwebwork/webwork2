msgid ""
"The following variables are available for use in the template.  These "
"variables can be used inside %1 tags.  For example, %2 will insert the "
"description of the achievement into the email body."
msgstr "Las siguientes variables están disponibles para usar en la plantilla. Estas variables se pueden usar dentro de las etiquetas %1. Por ejemplo, %2 insertará la descripción del logro en el cuerpo del correo."

#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/Instructor/PGProblemEditor.pm:281
msgid "The given file path is not a valid location."
msgstr "La ruta de archivo dada no es una ubicación válida."

#: /opt/webwork/webwork2/templates/HelpFiles/InstructorAchievementEditor.html.ep:40
