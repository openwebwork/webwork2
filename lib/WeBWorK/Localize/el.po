#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/Instructor/PGProblemEditor.pm:630
msgid ""
"The file %1 is not contained in the course templates directory and cannot be "
"modified."
msgstr "Το αρχείο %1 δεν περιέχεται στον κατάλογο προτύπων του μαθήματος και δεν μπορεί να τροποποιηθεί."

#. ("$emailDirectory/$openfilename")
#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/Instructor/SendMail.pm:130
msgid ""
"The file %1 is not readable by the webserver. Check that it's permissions "
"are set correctly."
msgstr "Το αρχείο %1 δεν είναι αναγνώσιμο από τον διακομιστή ιστού. Ελέγξτε ότι τα δικαιώματά του είναι σωστά ορισμένα."

#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/Instructor/FileManager.pm:218
msgid "The file does not appear to be a text file"
msgstr "Το αρχείο δεν φαίνεται να είναι αρχείο κειμένου"

#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/Instructor/FileManager.pm:106
msgid "The file you are trying to download doesn't exist"
msgstr "Το αρχείο που προσπαθείτε να κατεβάσετε δεν υπάρχει"

#. ($filename)
#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/Feedback.pm:176
msgid "The filetype of the attached file \"%1\" is not allowed."
msgstr "Ο τύπος αρχείου του συνημμένου αρχείου \"%1\" δεν επιτρέπεται."

#: /opt/webwork/webwork2/templates/HelpFiles/Options.html.ep:12
msgid ""
"The first and last name can be any combination of letters, numbers and "
"special symbols. Name changes and preferences can be respected here. "
"Students should use a name that will not confuse their instructor. If "
"WeBWorK is used with an LMS (Canvas, Moodle, D2L, Blackboard, etc) the LMS "
"might periodically override a name setting here if WeBWorK is configured to "
"allow that. Name settings will only appear here if a user has permission to "
"change their name."
msgstr "Το μικρό όνομα και το επώνυμο μπορούν να είναι οποιοσδήποτε συνδυασμός γραμμάτων, αριθμών και ειδικών συμβόλων. Οι αλλαγές ονόματος και οι προτιμήσεις μπορούν να τηρηθούν εδώ. Οι σπουδαστές πρέπει να χρησιμοποιούν ένα όνομα που δεν θα προκαλέσει σύγχυση στον καθηγητή τους. Εάν το WeBWorK χρησιμοποιείται με ένα LMS (Canvas, Moodle, D2L, Blackboard, κ.λπ.) το LMS ενδέχεται να αντικαθιστά περιοδικά μια ρύθμιση ονόματος εδώ εάν το WeBWorK είναι διαμορφωμένο να το επιτρέπει αυτό. Οι ρυθμίσεις ονόματος θα εμφανιστούν εδώ μόνο εάν ένας χρήστης έχει δικαίωμα να αλλάξει το όνομά του."

#. (scalar(@existing_files)
#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/Instructor/FileManager.pm:704
msgid ""
"The following %plural(%1,file already exists,files already exist). Check "
"\"Overwrite existing files silently\" to unpack %plural(%1,this file,these "
"files)."
msgstr "%plural(%1,Το ακόλουθο αρχείο υπάρχει ήδη,Τα ακόλουθα αρχεία υπάρχουν ήδη). Επιλέξτε \"Σιωπηλή αντικατάσταση υπαρχόντων αρχείων\" για να αποσυμπιέσετε %plural(%1,αυτό το αρχείο,αυτά τα αρχεία)."

#. (scalar(@outside_files)
#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/Instructor/FileManager.pm:647
msgid ""
"The following %plural(%1,file is,files are) outside the current working "
"directory and cannot be safely unpacked."
msgstr "%plural(%1,Το ακόλουθο αρχείο είναι,Τα ακόλουθα αρχεία είναι) εκτός του τρέχοντος καταλόγου εργασίας και δεν μπορούν να αποσυμπιεστούν με ασφάλεια."

#. (scalar(@forbidden_files)
#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/Instructor/FileManager.pm:690
msgid ""
"The following %plural(%1,file) found in the archive %plural(%1,is,are) "
"protected and were not extracted."
msgstr "%plural(%1,Το ακόλουθο αρχείο,Τα ακόλουθα αρχεία) που βρέθηκαν στο αρχείο αρχειοθέτησης %plural(%1,είναι,είναι) προστατευμένα και δεν εξήχθησαν."

#. (scalar(@unsafe_links)
#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/Instructor/FileManager.pm:675
msgid ""
"The following %plural(%1,symbolic link) in the archive "
"%plural(%1,points,point) outside the course directory or %plural(%1,is,are) "
"broken, and %plural(%1,was,were) not created."
msgstr "%plural(%1,Ο ακόλουθος συμβολικός σύνδεσμος,Οι ακόλουθοι συμβολικοί σύνδεσμοι) στο αρχείο αρχειοθέτησης %plural(%1,δείχνει,δείχνουν) εκτός του καταλόγου μαθήματος ή %plural(%1,είναι,είναι) κατεστραμμένος, και %plural(%1,δεν δημιουργήθηκε,δεν δημιουργήθηκαν)."

#: /opt/webwork/webwork2/templates/ContentGenerator/Instructor/PGProblemEditor/pg_critic.html.ep:11
msgid "The following PG issues should be fixed:"
msgstr "Τα ακόλουθα ζητήματα PG πρέπει να διορθωθούν:"

#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/CourseAdmin.pm:2243
msgid "The following courses were successfully hidden:"
msgstr "Τα ακόλουθα μαθήματα αποκρύφθηκαν επιτυχώς:"

#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/CourseAdmin.pm:2312
msgid "The following courses were successfully unhidden:"
msgstr "Τα ακόλουθα μαθήματα εμφανίστηκαν επιτυχώς:"

#: /opt/webwork/webwork2/templates/HelpFiles/InstructorScoring.html.ep:21
msgid "The following describes how the checkboxes alter the scoring output"
msgstr "Τα ακόλουθα περιγράφουν πώς τα πλαίσια επιλογής αλλάζουν την έξοδο βαθμολόγησης"

#: /opt/webwork/webwork2/templates/ContentGenerator/Instructor/FileManager/archive.html.ep:6
msgid ""
"The following files have been selected for archiving.  Select the type of "
"archive and any subset of the requested files."
msgstr "Τα ακόλουθα αρχεία έχουν επιλεγεί για αρχειοθέτηση. Επιλέξτε τον τύπο αρχείου και οποιοδήποτε υποσύνολο των ζητούμενων αρχείων."

#: /opt/webwork/webwork2/templates/ContentGenerator/Instructor/PGProblemEditor/pg_critic.html.ep:48
msgid "The following general Perl issues should be fixed:"
msgstr "Τα ακόλουθα γενικά ζητήματα Perl πρέπει να διορθωθούν:"

#. (tag('b', join(', ', @$unassignedUsers)
#: /opt/webwork/webwork2/templates/ContentGenerator/Instructor/ProblemSetDetail.html.ep:71
msgid ""
"The following users are NOT assigned to this set and will be ignored: %1"
msgstr ""
"Οι ακόλουθοι χρήστες ΔΕΝ έχουν εκχωρηθεί σε αυτό το σύνολο ασκήσεων και θα "
"αγνοηθούν: %1"

#. ('<code>&lt;%= ... %&gt;</code>',		'<code>&lt;%= $achievement->description %&gt;</code>')
#: /opt/webwork/webwork2/templates/HelpFiles/InstructorAchievementNotificationEditor.html.ep:35
msgid ""
"The following variables are available for use in the template.  These "
"variables can be used inside %1 tags.  For example, %2 will insert the "
"description of the achievement into the email body."
msgstr "Οι ακόλουθες μεταβλητές είναι διαθέσιμες προς χρήση στο πρότυπο. Αυτές οι μεταβλητές μπορούν να χρησιμοποιηθούν μέσα σε ετικέτες %1. Για παράδειγμα, το %2 θα εισάγει την περιγραφή του επιτεύγματος στο σώμα του email."

#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/Instructor/PGProblemEditor.pm:281
msgid "The given file path is not a valid location."
msgstr "Η δεδομένη διαδρομή αρχείου δεν είναι έγκυρη τοποθεσία."

#: /opt/webwork/webwork2/templates/HelpFiles/InstructorAchievementEditor.html.ep:40
msgid "The goal value of the achievement counter."
msgstr "Η τιμή στόχου του μετρητή επιτεύγματος."

#. (join('.', @{ $problemSeqs[ $children_counts_indices[0] ] })
#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/Problem.pm:1159
msgid ""
"The grade for this problem is the larger of the score for this problem, or "
"the score of problem %1."
msgstr ""
"Ο βαθμός για αυτό το πρόβλημα είναι το μεγαλύτερο σκορ για αυτό το πρόβλημα "
"ή το σκορ του προβλήματος %1."

#. (join(', ', map({ join('.', @{ $problemSeqs[$_] })
#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/Problem.pm:1169
msgid ""
"The grade for this problem is the larger of the score for this problem, or "
"the weighted average of the problems: %1."
msgstr ""
"Ο βαθμός για αυτό το πρόβλημα είναι το μεγαλύτερο σκορ για αυτό το πρόβλημα "
"ή ο σταθμισμένος μέσος όρος των προβλημάτων: %1."

#: /opt/webwork/webwork2/templates/HelpFiles/Grades.html.ep:15
msgid ""
"The grades are divided into open, reduced scoring, closed, and future "
"assignments.  No grades are shown for future assignments, just their open "
"date.  Assignments are sorted using the same urgency logic as the "
"\"Assignments\" page.  For open assignments, a table of per problem scores "
"are shown for homework assignments. Just in time assignments only show top "
"level problems.  Tests only show the best test version provided students can "
"see the test grade."
msgstr "Οι βαθμοί χωρίζονται σε ανοιχτές, μειωμένης βαθμολόγησης, κλειστές, και μελλοντικές αναθέσεις. Δεν εμφανίζονται βαθμοί για μελλοντικές αναθέσεις, μόνο η ημερομηνία έναρξής τους. Οι αναθέσεις ταξινομούνται χρησιμοποιώντας την ίδια λογική επείγοντος όπως η σελίδα \"Αναθέσεις\". Για ανοιχτές αναθέσεις, εμφανίζεται πίνακας βαθμολογιών ανά άσκηση για αναθέσεις εργασίας. Οι αναθέσεις just-in-time εμφανίζουν μόνο ασκήσεις ανώτατου επιπέδου. Τα διαγωνίσματα εμφανίζουν μόνο την καλύτερη έκδοση διαγωνίσματος, εφόσον οι σπουδαστές μπορούν να δουν τον βαθμό του διαγωνίσματος."

#. ($c->{setID},							$c->shortPath($outputFilePath)
#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/Instructor/PGProblemEditor.pm:1183
msgid "The hardcopy header for set %1 has been set to \"%2\"."
msgstr "Η κεφαλίδα εκτυπώσιμου αντιγράφου για το σύνολο ασκήσεων %1 ορίστηκε σε \"%2\"."

#. ($showHintsAfter)
#: /opt/webwork/webwork2/templates/ContentGenerator/Problem/messages.html.ep:34
msgid ""
"The hint shown is an instructor preview and will be shown to students after "
"%quant(%1,attempt)."
msgstr "Η υπόδειξη που εμφανίζεται είναι προεπισκόπηση καθηγητή και θα εμφανιστεί στους σπουδαστές μετά από %quant(%1,προσπάθεια)."

#: /opt/webwork/webwork2/templates/ContentGenerator/Problem/messages.html.ep:30
msgid ""
"The hint shown is an instructor preview and will not be shown to students."
msgstr "Η υπόδειξη που εμφανίζεται είναι προεπισκόπηση καθηγητή και δεν θα εμφανιστεί στους σπουδαστές."

#: /opt/webwork/webwork2/templates/HelpFiles/ProblemSets.html.ep:7
msgid ""
"The information box on the right displays information about the course. This "
"is useful for leaving course wide messages for students. It contains text "
"from the file templates/course_info.txt. Instructors can edit this file from "
"the web (click on the \"Edit\" link)."
msgstr "Το πλαίσιο πληροφοριών στα δεξιά εμφανίζει πληροφορίες σχετικά με το μάθημα. Αυτό είναι χρήσιμο για την αφήγηση μηνυμάτων σε επίπεδο μαθήματος για τους σπουδαστές. Περιέχει κείμενο από το αρχείο templates/course_info.txt. Οι καθηγητές μπορούν να επεξεργαστούν αυτό το αρχείο από τον ιστό (κάντε κλικ στον σύνδεσμο \"Επεξεργασία\")."

#: /opt/webwork/webwork2/templates/HTML/SingleProblemGrader/grader.html.ep:45
msgid ""
"The initial value is the answer sub score for the answer that is currently "
"shown.  If this is modified, it will be used to compute the total problem "
"score below.  This score is not saved, and will reset to the score for the "
"shown answer if the page is reloaded."
msgstr ""
"Η αρχική τιμή είναι η απάντηση της δευτερεύουσας βαθμολογίας για την "
"απάντηση που προβάλλεται αυτή τη στιγμή. Αν αυτό αλλάξει, θα χρησιμοποιηθεί "
"για να υπολογίσει το συνολικό σκορ του προβλήματος παρακάτω. Αυτό το σκορ "
"δεν έχει αποθηκευτεί και θα επαναφερθεί στο σκορ που εμφανίζεται, αν η "
"σελίδα ξαναφορτώσει."

#: /opt/webwork/webwork2/templates/HTML/SingleProblemGrader/grader.html.ep:108
msgid ""
"The initial value is the currently saved score as a point value computed "
"using the percent score.  This point value is used to compute the percent "
"score (rounded to a whole percent) that can be saved."
msgstr "Η αρχική τιμή είναι η τρέχουσα αποθηκευμένη βαθμολογία ως τιμή βαθμών υπολογισμένη χρησιμοποιώντας το ποσοστό βαθμολογίας. Αυτή η τιμή βαθμών χρησιμοποιείται για τον υπολογισμό του ποσοστού βαθμολογίας (στρογγυλοποιημένο σε ακέραιο ποσοστό) που μπορεί να αποθηκευτεί."

#: /opt/webwork/webwork2/templates/HTML/SingleProblemGrader/grader.html.ep:185
msgid "The initial value is the currently saved score for this student."
msgstr "Η αρχική τιμή είναι το τρέχον αποθηκευμένο σκορ για αυτόν τον μαθητή."

#. ($rename_oldCourseID, $rename_oldCourseInstitution, $rename_newCourseInstitution)
#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/CourseAdmin.pm:663
msgid ""
"The institution associated with the course %1 has been changed from %2 to %3"
msgstr "Το ίδρυμα που σχετίζεται με το μάθημα %1 έχει αλλάξει από %2 σε %3"

#. ($rename_newCourseID, $optional_arguments{courseInstitution})
#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/CourseAdmin.pm:696
msgid "The institution associated with the course %1 is now %2"
msgstr "Το ίδρυμα που σχετίζεται με το μάθημα %1 είναι τώρα %2"

#: /opt/webwork/webwork2/templates/HelpFiles/InstructorJobManager.html.ep:13
msgid ""
"The job id is an automatically incremented integer.  It is used internally "
"to uniquely identify jobs.  It is also used to reference jobs in messages on "
"this page."
msgstr "Το id εργασίας είναι ένας αυτόματα αυξανόμενος ακέραιος. Χρησιμοποιείται εσωτερικά για τη μοναδική αναγνώριση εργασιών. Χρησιμοποιείται επίσης για την αναφορά εργασιών σε μηνύματα σε αυτή τη σελίδα."

#: /opt/webwork/webwork2/templates/HelpFiles/InstructorPGProblemEditor.html.ep:128
msgid ""
"The key maps that are available are \"default\", \"emacs\", \"sublime\", and "
"\"vim\". The \"default\" key map has the standard behavior of a browser text "
"area. You can use Ctrl-C to copy, Ctrl-V to paste, Ctrl-F to search, etc. If "
"you are more comfortable with the \"emacs\"  or \"vim\" text editors then "
"you may choose to use one of those key maps instead."
msgstr "Οι διαθέσιμοι χάρτες πλήκτρων είναι \"προεπιλογή\", \"emacs\", \"sublime\", και \"vim\". Ο χάρτης πλήκτρων \"προεπιλογή\" έχει την τυπική συμπεριφορά μιας περιοχής κειμένου προγράμματος περιήγησης. Μπορείτε να χρησιμοποιήσετε Ctrl-C για αντιγραφή, Ctrl-V για επικόλληση, Ctrl-F για αναζήτηση, κ.λπ. Εάν είστε πιο εξοικειωμένοι με τους επεξεργαστές κειμένου \"emacs\" ή \"vim\" τότε μπορείτε να επιλέξετε να χρησιμοποιήσετε έναν από αυτούς τους χάρτες πλήκτρων αντ' αυτού."

#: /opt/webwork/webwork2/templates/HelpFiles/AchievementsLeaderboard.html.ep:5
msgid ""
"The leaderboard orders the achievement points earned from the greatest to "
"the least. The rank of each user is determined by their position on the "
"leader board. All users with the same number of achievement points have the "
"same rank."
msgstr "Ο πίνακας κατάταξης ταξινομεί τους πόντους επιτεύγματος που κερδήθηκαν από τους περισσότερους στους λιγότερους. Η κατάταξη κάθε χρήστη καθορίζεται από τη θέση του στον πίνακα κατάταξης. Όλοι οι χρήστες με τον ίδιο αριθμό πόντων επιτεύγματος έχουν την ίδια κατάταξη."

#: /opt/webwork/webwork2/templates/HelpFiles/InstructorFileManager.html.ep:12
msgid ""
"The list of files include regular files, directories (ending in a \"/\") and "
"links (ending in a \"@\")."
msgstr "Η λίστα αρχείων περιλαμβάνει κανονικά αρχεία, καταλόγους (που τελειώνουν σε \"/\") και συνδέσμους (που τελειώνουν σε \"@\")."

#: /opt/webwork/webwork2/templates/HelpFiles/InstructorUserList.html.ep:37
msgid ""
"The login name cannot be changed. (It is the primary key for the student's "
"data.) If you make a mistake in the login name at the beginning of the "
"course (before any work has been done) then it is best to simply add a new "
"student with the correct entry and drop the student with the bad login name. "
"(See drop and delete students below.) If the login name must be changed "
"after a user has started working assignments, then contact your system "
"administrator, who can use the webwork2 \"bin/change_user_id\" script to "
"change the user id."
msgstr "Το όνομα σύνδεσης δεν μπορεί να αλλαχθεί. (Είναι το πρωτεύον κλειδί για τα δεδομένα του σπουδαστή.) Εάν κάνετε λάθος στο όνομα σύνδεσης στην αρχή του μαθήματος (πριν γίνει οποιαδήποτε εργασία) τότε είναι καλύτερα να προσθέσετε απλά έναν νέο σπουδαστή με τη σωστή καταχώρηση και να αποχωρήσετε τον σπουδαστή με το λανθασμένο όνομα σύνδεσης. (Δείτε αποχώρηση και διαγραφή σπουδαστών παρακάτω.) Εάν το όνομα σύνδεσης πρέπει να αλλαχθεί αφού ένας χρήστης έχει ξεκινήσει να εργάζεται σε αναθέσεις, τότε επικοινωνήστε με τον διαχειριστή συστήματός σας, ο οποίος μπορεί να χρησιμοποιήσει το σενάριο webwork2 \"bin/change_user_id\" για να αλλάξει το id χρήστη."

#. ('href="https://wiki.openwebwork.org/wiki" target="ww_wiki"',	'href="https://wiki.openwebwork.org/wiki/Instructors" target="ww_wiki"')
#: /opt/webwork/webwork2/templates/HelpFiles/instructor_links.html.ep:10
msgid ""
"The main page for WeBWorK documentation is the <a %1>webwork wiki</a> while "
"specific help for instructors setting up a course are in the <a "
"%2>instructors' section</a>."
msgstr "Η κύρια σελίδα για την τεκμηρίωση του WeBWorK είναι το <a %1>webwork wiki</a> ενώ συγκεκριμένη βοήθεια για καθηγητές που ρυθμίζουν ένα μάθημα βρίσκεται στην <a %2>ενότητα καθηγητών</a>."

#. ($c->param('new_set_name')
#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/Instructor/SetMaker.pm:556
msgid ""
"The name \"%1\" is not a valid set name.  Use only letters, digits, dashes, "
"underscores, periods, and spaces."
msgstr ""
"Το όνομα \"%1\" δεν είναι έγκυρο όνομα συνόλου. Χρησιμοποιήστε μόνο "
"γράμματα, ψηφία, παύλες, κάτω παύλες, τελείες και κενά."

#: /opt/webwork/webwork2/lib/WeBWorK/ConfigValues.pm:83
msgid ""
"The name of course information file (located in the templates directory). "
"Its contents are displayed in the right panel next to the list of homework "
"sets."
msgstr ""
"Το όνομα του αρχείου πληροφοριών μαθημάτων (βρίσκεται στον κατάλογο "
"προτύπων). Τα περιεχόμενά του εμφανίζονται στο δεξί πάνελ δίπλα στη λίστα το "
"σύνολο των ασκήσεων."

#: /opt/webwork/webwork2/lib/WeBWorK/ConfigValues.pm:939
msgid "The name of the LMS"
msgstr "Το όνομα του LMS"

#: /opt/webwork/webwork2/lib/WeBWorK/ConfigValues.pm:941
msgid ""
"The name of the LMS. This is used in messages to users that direct them to "
"go back to the LMS to access something in the WeBWorK course."
msgstr ""
"Το όνομα του LMS. Αυτό χρησιμοποιείται σε μηνύματα προς τους χρήστες που "
"τους κατευθύνουν να επιστρέψουν στο LMS για πρόσβαση σε κάτι στο μάθημα "
"WeBWorK."

#: /opt/webwork/webwork2/templates/HelpFiles/InstructorJobManager.html.ep:18
msgid "The name of the task."
msgstr "Το όνομα της εργασίας."

#. ($achievementID, $sourceFile)
#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/Instructor/AchievementNotificationEditor.pm:240
msgid "The notification for %1 has been changed to \"%2\"."
msgstr "Η ειδοποίηση για το %1 άλλαξε σε \"%2\"."

#: /opt/webwork/webwork2/templates/HelpFiles/InstructorAchievementList.html.ep:49
msgid "The number of points earned for earning the achievement."
msgstr "Ο αριθμός πόντων που κερδίζονται για την απόκτηση του επιτεύγματος."

#: /opt/webwork/webwork2/lib/WeBWorK/File/SetDef.pm:336
msgid ""
"The open date, due date, and answer date in \"%1\" are not in chronological "
"order. Default values will be used for dates that are out of order."
msgstr "Η ημερομηνία έναρξης, η ημερομηνία λήξης, και η ημερομηνία απάντησης στο \"%1\" δεν είναι σε χρονολογική σειρά. Θα χρησιμοποιηθούν προεπιλεγμένες τιμές για ημερομηνίες που δεν είναι σε σειρά."

#. ($path)
#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/Instructor/PGProblemEditor.pm:431
msgid "The original path is not in a valid location. Using failsafe %1"
msgstr "Η αρχική διαδρομή δεν είναι σε έγκυρη τοποθεσία. Χρησιμοποιείται η ασφαλής εναλλακτική %1"

#. ($forcedSourceFile)
#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/Instructor/PGProblemEditor.pm:548
msgid "The original path to the file is %1."
msgstr "Η αρχική διαδρομή προς το αρχείο είναι %1."

#: /opt/webwork/webwork2/templates/HelpFiles/Options.html.ep:20
msgid ""
"The password can be any combination of letters, numbers and special symbols. "
"Students are encouraged to use all three, and stay away from dictionary "
"words. The password should not be the same as any password used elsewhere, "
"such as for an email account. The password will only be present on the page "
"if the user has permission to change the password."
msgstr "Ο κωδικός πρόσβασης μπορεί να είναι οποιοσδήποτε συνδυασμός γραμμάτων, αριθμών και ειδικών συμβόλων. Οι σπουδαστές ενθαρρύνονται να χρησιμοποιούν και τα τρία, και να αποφεύγουν λέξεις λεξικού. Ο κωδικός πρόσβασης δεν πρέπει να είναι ίδιος με οποιονδήποτε άλλο κωδικό πρόσβασης που χρησιμοποιείται αλλού, όπως για έναν λογαριασμό email. Ο κωδικός πρόσβασης θα είναι παρών στη σελίδα μόνο εάν ο χρήστης έχει δικαίωμα να αλλάξει τον κωδικό πρόσβασης."

#. ($c->tag('b', $fieldText)
#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/Options.pm:89
msgid ""
"The password you entered in the %1 field does not match your current "
"password. Please retype your current password and try again."
msgstr ""
"Ο κωδικός που εισάγατε στο πεδίο %1 δεν ταιριάζει με τον τρέχοντα κωδικό "
"πρόσβασης σας. Παρακαλώ πληκτρολογήστε ξανά τον τρέχοντα κωδικό πρόσβασης "
"και προσπαθήστε ξανά."

#: /opt/webwork/webwork2/lib/WeBWorK/Authen.pm:510
#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/ResetPassword.pm:71
msgid ""
"The passwords you entered in the \"New Password\" and \"Confirm New "
"Password\" fields do not match. Please retype your new password and try "
"again."
msgstr "Οι κωδικοί πρόσβασης που εισάγατε στα πεδία \"Νέος κωδικός πρόσβασης\" και \"Επιβεβαίωση νέου κωδικού πρόσβασης\" δεν ταιριάζουν. Πληκτρολογήστε ξανά τον νέο κωδικό πρόσβασής σας και δοκιμάστε ξανά."

#. ($c->tag('b', $newPasswordText)
#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/Options.pm:79
msgid ""
"The passwords you entered in the %1 and %2 fields don't match. Please retype "
"your new password and try again."
msgstr ""
"Οι κωδικοί πρόσβασης που εισάγατε στα πεδία %1 και %2 δεν ταιριάζουν. "
"Παρακαλώ πληκτρολογήστε ξανά τον νέο κωδικό σας και προσπαθήστε ξανά."

#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/Instructor/PGProblemEditor.pm:407
msgid "The path cannot be the temporary edit directory."
msgstr "Η διαδρομή δεν μπορεί να είναι ο προσωρινός κατάλογος επεξεργασίας."

#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/Instructor/PGProblemEditor.pm:403
msgid "The path to the original file should be absolute."
msgstr "Η διαδρομή προς το αρχικό αρχείο πρέπει να είναι απόλυτη."

#: /opt/webwork/webwork2/templates/ContentGenerator/Instructor/Stats/set_stats.html.ep:160
msgid ""
"The percentage of students receiving at least these scores. The median score "
"is in the 50% column."
msgstr ""
"Το ποσοστό των σπουδαστών που λαμβάνουν τουλάχιστον αυτά τα σκορ. Το διάμεσο "
"σκορ είναι στη στήλη 50%."

#: /opt/webwork/webwork2/lib/WeBWorK/ConfigValues.pm:673
msgid ""
"The permission level to view the achievements leaderboard, if achievements "
"are enabled. Consider that achievement points can be closely tied to student "
"grades before showing the leaderboard to students."
msgstr "Το επίπεδο δικαιωμάτων για προβολή του πίνακα κατάταξης επιτευγμάτων, εάν τα επιτεύγματα είναι ενεργοποιημένα. Εξετάστε ότι οι πόντοι επιτεύγματος μπορεί να συνδέονται στενά με τους βαθμούς σπουδαστών πριν εμφανίσετε τον πίνακα κατάταξης στους σπουδαστές."

#: /opt/webwork/webwork2/lib/WeBWorK/ConfigValues.pm:683
msgid ""
"The permission level to view usernames on the achievements leaderboard. "
"Consider that achievement points can be closely tied to student grades "
"before showing user names to students."
msgstr "Το επίπεδο δικαιωμάτων για προβολή ονομάτων χρηστών στον πίνακα κατάταξης επιτευγμάτων. Εξετάστε ότι οι πόντοι επιτεύγματος μπορεί να συνδέονται στενά με τους βαθμούς σπουδαστών πριν εμφανίσετε ονόματα χρηστών στους σπουδαστές."

#: /opt/webwork/webwork2/templates/HelpFiles/InstructorProblemGrader.html.ep:11
msgid ""
"The problem is shown at the top with the seed and answers of the selected "
"student.  Use the drop down menu to change which student's seed and answers "
"are shown.  Use the \"Mark Correct\" checkbox to set the score to 100%.  The "
"feedback comment can contain LaTeX formulas using the deliminator \"\\\\"
"( ... \\)\" for math mode, and is placed above the student's problem.  "
"Students can access the feedback comments by going to the page for the "
"associated set and problem number."
msgstr "Η άσκηση εμφανίζεται στην κορυφή με τον σπόρο και τις απαντήσεις του επιλεγμένου σπουδαστή. Χρησιμοποιήστε το αναπτυσσόμενο μενού για να αλλάξετε ποιου σπουδαστή ο σπόρος και οι απαντήσεις εμφανίζονται. Χρησιμοποιήστε το πλαίσιο επιλογής \"Σήμανση ως σωστό\" για να ορίσετε τη βαθμολογία σε 100%. Το σχόλιο ανατροφοδότησης μπορεί να περιέχει τύπους LaTeX χρησιμοποιώντας τον οριοθέτη \"\\\\( ... \\)\" για λειτουργία μαθηματικών, και τοποθετείται πάνω από την άσκηση του σπουδαστή. Οι σπουδαστές μπορούν να έχουν πρόσβαση στα σχόλια ανατροφοδότησης μεταβαίνοντας στη σελίδα για το συσχετισμένο σύνολο ασκήσεων και τον αριθμό άσκησης."

#: /opt/webwork/webwork2/templates/ContentGenerator/Problem/submit_buttons.html.ep:100
msgid "The problem set is not yet open"
msgstr "Το σύνολο προβλημάτων δεν είναι ακόμα ανοιχτό"

#: /opt/webwork/webwork2/lib/WeBWorK/File/SetDef.pm:384
msgid ""
"The reduced credit date in \"%1\" is not between the open date and close "
"date. The default value will be used."
msgstr "Η ημερομηνία μειωμένης βαθμολόγησης στο \"%1\" δεν είναι μεταξύ της ημερομηνίας έναρξης και της ημερομηνίας λήξης. Θα χρησιμοποιηθεί η προεπιλεγμένη τιμή."

#. ($setID)
#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/Instructor/UserDetail.pm:192
msgid ""
"The reduced scoring date must be between the open date and the close date "
"for set %1."
msgstr "Η ημερομηνία μειωμένης βαθμολόγησης πρέπει να είναι μεταξύ της ημερομηνίας έναρξης και της ημερομηνίας λήξης για το σύνολο ασκήσεων %1."

#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/Instructor/ProblemSetDetail.pm:1390
msgid ""
"The reduced scoring date should be between the open date and close date."
msgstr ""
"Η μειωμένη ημερομηνία βαθμολόγησης πρέπει να είναι μεταξύ της ημερομηνίας "
"έναρξης και της ημερομηνίας κλεισίματος."

#. ($_)
#: /opt/webwork/webwork2/lib/WeBWorK/ConfigObject/lms_context_id.pm:56
msgid ""
"The requested LMS Context ID is the same as that of another course that is "
"also configured to use LTI 1.1, but the consumer keys for both this course "
"and that course are either both not set or are the same. This is not "
"allowed, and so this setting was not saved."
msgstr "Το ζητούμενο Context ID LMS είναι ίδιο με αυτό ενός άλλου μαθήματος που είναι επίσης διαμορφωμένο να χρησιμοποιεί LTI 1.1, αλλά τα consumer keys τόσο για αυτό το μάθημα όσο και για εκείνο το μάθημα είτε δεν είναι και τα δύο ορισμένα είτε είναι ίδια. Αυτό δεν επιτρέπεται, και έτσι αυτή η ρύθμιση δεν αποθηκεύτηκε."

#: /opt/webwork/webwork2/lib/WeBWorK/ConfigObject/lms_context_id.pm:68
msgid ""
"The requested LMS Context ID is the same as that of another course that is "
"also configured to use LTI 1.3, but this course and that course have the "
"same LTI 1.3 authentication parameters. This is not allowed, and so this "
"setting was not saved."
msgstr "Το ζητούμενο Context ID LMS είναι ίδιο με αυτό ενός άλλου μαθήματος που είναι επίσης διαμορφωμένο να χρησιμοποιεί LTI 1.3, αλλά αυτό το μάθημα και εκείνο το μάθημα έχουν τις ίδιες παραμέτρους ταυτοποίησης LTI 1.3. Αυτό δεν επιτρέπεται, και έτσι αυτή η ρύθμιση δεν αποθηκεύτηκε."

#. (xml_escape($tempFile)
#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/Hardcopy.pm:288
msgid "The requested file \"%1\" does not exist on the server."
msgstr "Το ζητούμενο αρχείο \"%1\" δεν υπάρχει στον διακομιστή."

#. (join('.', @seq)
#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/Problem.pm:1212
msgid "The score for this problem can count toward score of problem %1."
msgstr "Η βαθμολογία για αυτή την άσκηση μπορεί να μετρήσει προς τη βαθμολογία της άσκησης %1."

#. ('<code>courseName_totals.csv</code>')
#: /opt/webwork/webwork2/templates/HelpFiles/InstructorFileManager.html.ep:61
msgid ""
"The scoring files are stored in the scoring directory and are produced using "
"the \"Scoring Tools\" page or the scoring command in the \"Instructor "
"Tools\" module. These files can be downloaded, modified in a spreadsheet "
"(for example, to add midterm scores) and then uploaded again to the scoring "
"directory to be merged with email messages. (Use a new file name, other than "
"%1, when uploading to prevent the scoring module from overwriting an "
"uploaded file.)"
msgstr "Τα αρχεία βαθμολόγησης αποθηκεύονται στον κατάλογο βαθμολόγησης και παράγονται χρησιμοποιώντας τη σελίδα \"Εργαλεία βαθμολόγησης\" ή την εντολή βαθμολόγησης στη λειτουργική μονάδα \"Εργαλεία καθηγητή\". Αυτά τα αρχεία μπορούν να ληφθούν, να τροποποιηθούν σε ένα υπολογιστικό φύλλο (για παράδειγμα, για να προστεθούν βαθμολογίες ενδιάμεσης εξέτασης) και έπειτα να μεταφορτωθούν ξανά στον κατάλογο βαθμολόγησης για να συγχωνευθούν με μηνύματα email. (Χρησιμοποιήστε ένα νέο όνομα αρχείου, διαφορετικό από το %1, κατά τη μεταφόρτωση για να αποτρέψετε τη λειτουργική μονάδα βαθμολόγησης από το να αντικαταστήσει ένα μεταφορτωμένο αρχείο.)"

#: /opt/webwork/webwork2/templates/HelpFiles/InstructorSetMaker.html.ep:37
msgid ""
"The second row of the problem collection area is for browsing directories. "
"The OPL will be there as well as any other directories that you may set up "
"(for example Contrib). If this is selected, all subdirectories containing "
"problems will be listed."
msgstr "Η δεύτερη γραμμή της περιοχής συλλογής ασκήσεων είναι για περιήγηση καταλόγων. Το OPL θα είναι εκεί καθώς και οποιοιδήποτε άλλοι κατάλογοι που ίσως ρυθμίσετε (για παράδειγμα Contrib). Εάν αυτό είναι επιλεγμένο, θα παρατεθούν όλοι οι υποκατάλογοι που περιέχουν ασκήσεις."

#: /opt/webwork/webwork2/lib/WeBWorK/Authen.pm:564
msgid "The security code is required."
msgstr "Ο κωδικός ασφαλείας απαιτείται."

#. (stash('setID')
#: /opt/webwork/webwork2/templates/ContentGenerator/ProblemSet.html.ep:17
msgid "The selected problem set (%1) is not a valid set for %2."
msgstr "Το επιλεγμένο σύνολο ασκήσεων (%1) δεν είναι έγκυρο σύνολο για %2."

#. ($setID, $effectiveUserID)
#: /opt/webwork/webwork2/templates/ContentGenerator/GatewayQuiz.html.ep:71
msgid "The selected test (%1) is not a valid test for %2."
msgstr "Το επιλεγμένο διαγώνισμα (%1) δεν είναι έγκυρο διαγώνισμα για %2."

#. ($newSetName)
#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/Instructor/SetMaker.pm:568
msgid "The set \"%1\" already exists."
msgstr "Το σύνολο ασκήσεων \"%1\" υπάρχει ήδη."

#. ($prettySetID)
#: /opt/webwork/webwork2/lib/WeBWorK/File/SetDef.pm:90
msgid "The set %1 already exists."
msgstr "Το σύνολο ασκήσεων %1 υπάρχει ήδη."

#. ($c->{setID},							$c->shortPath($outputFilePath)
#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/Instructor/PGProblemEditor.pm:1169
msgid "The set header for set %1 has been set to \"%2\"."
msgstr "Η κεφαλίδα συνόλου για το σύνολο ασκήσεων %1 ορίστηκε σε \"%2\"."

#. ($newSetID)
#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/Instructor/ProblemSetList.pm:450
msgid ""
"The set name \"%1\" is already in use. Pick a different name if you would "
"like to start a new set. No set created."
msgstr "Το όνομα συνόλου ασκήσεων \"%1\" χρησιμοποιείται ήδη. Επιλέξτε διαφορετικό όνομα εάν θέλετε να ξεκινήσετε νέο σύνολο ασκήσεων. Δεν δημιουργήθηκε σύνολο ασκήσεων."

#: /opt/webwork/webwork2/templates/HelpFiles/InstructorProblemSetList.html.ep:46
msgid ""
"The sets checked below will be visible to students or hidden from students. "
"Useful for preparing sets ahead of time, but not showing them to students; "
"or for temporarily hiding a set which has a mistake in it while it is being "
"fixed."
msgstr "Τα σύνολα ασκήσεων που είναι επιλεγμένα παρακάτω θα είναι ορατά ή κρυφά στους σπουδαστές. Χρήσιμο για την προετοιμασία συνόλων ασκήσεων εκ των προτέρων, χωρίς να τα εμφανίζετε στους σπουδαστές· ή για την προσωρινή απόκρυψη ενός συνόλου ασκήσεων που έχει λάθος ενώ διορθώνεται."

#: /opt/webwork/webwork2/templates/HelpFiles/InstructorProblemSetList.html.ep:42
msgid ""
"The sets checked below will become available for editing the due dates and "
"visibility."
msgstr "Τα σύνολα ασκήσεων που είναι επιλεγμένα παρακάτω θα γίνουν διαθέσιμα για επεξεργασία των ημερομηνιών λήξης και της ορατότητας."

#: /opt/webwork/webwork2/templates/HelpFiles/InstructorProblemSetList.html.ep:61
msgid ""
"The sets checked below will written to set definition files, to be saved for "
"future use, or to be transferred to another course. The set definition files "
"can be uploaded/downloaded using the \"File Manager\"."
msgstr "Τα σύνολα ασκήσεων που είναι επιλεγμένα παρακάτω θα γραφτούν σε αρχεία ορισμού συνόλου, για αποθήκευση για μελλοντική χρήση, ή για μεταφορά σε άλλο μάθημα. Τα αρχεία ορισμού συνόλου μπορούν να μεταφορτωθούν/ληφθούν χρησιμοποιώντας τη \"Διαχείριση αρχείων\"."

#: /opt/webwork/webwork2/templates/HelpFiles/InstructorConfig.html.ep:13
msgid ""
"The settings for all tabs are saved when \"Save Changes\" is clicked, "
"including settings that are not in the currently active tab."
msgstr "Οι ρυθμίσεις για όλες τις καρτέλες αποθηκεύονται όταν πατηθεί το \"Αποθήκευση αλλαγών\", συμπεριλαμβανομένων ρυθμίσεων που δεν είναι στην τρέχουσα ενεργή καρτέλα."

#: /opt/webwork/webwork2/templates/ContentGenerator/Problem/messages.html.ep:43
#: /opt/webwork/webwork2/templates/ContentGenerator/ShowMeAnother/messages.html.ep:31
msgid ""
"The solution shown is an instructor preview and will only be shown to "
"students after the answer date."
msgstr "Η λύση που εμφανίζεται είναι προεπισκόπηση καθηγητή και θα εμφανιστεί στους σπουδαστές μόνο μετά την ημερομηνία απάντησης."

#: /opt/webwork/webwork2/templates/ContentGenerator/GatewayQuiz.html.ep:657
msgid ""
"The solution shown is an instructor preview and will only be shown to "
"students when answers are available."
msgstr "Η λύση που εμφανίζεται είναι προεπισκόπηση καθηγητή και θα εμφανιστεί στους σπουδαστές μόνο όταν οι απαντήσεις είναι διαθέσιμες."

#. ($c->{setID},					$c->{prettyProblemNumber},					$c->shortPath($c->{sourceFilePath})
#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/Instructor/PGProblemEditor.pm:1150
msgid ""
"The source file for \"set %1 / problem %2\" has been changed from \"%3\" to "
"\"%4\"."
msgstr "Το αρχείο πηγής για \"σύνολο ασκήσεων %1 / άσκηση %2\" άλλαξε από \"%3\" σε \"%4\"."

#. ($c->{editFilePath})
#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/Instructor/PGProblemEditor.pm:857
msgid ""
"The source file path %1 is not contained in the course templates directory "
"and cannot be added."
msgstr "Η διαδρομή αρχείου πηγής %1 δεν περιέχεται στον κατάλογο προτύπων του μαθήματος και δεν μπορεί να προστεθεί."

#. ($new_file_name)
#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/Instructor/PGProblemEditor.pm:1096
msgid "The specified file name \"%1\" contains illegal characters."
msgstr "Το καθορισμένο όνομα αρχείου \"%1\" περιέχει μη έγκυρους χαρακτήρες."

#. ($c->{tempFilePath})
#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/Instructor/PGProblemEditor.pm:1316
msgid ""
"The temporary file %1 is not contained in the course templates directory and "
"cannot be deleted."
msgstr "Το προσωρινό αρχείο %1 δεν περιέχεται στον κατάλογο προτύπων του μαθήματος και δεν μπορεί να διαγραφεί."

#. ($c->{tempFilePath})
#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/Instructor/PGProblemEditor.pm:727
msgid ""
"The temporary file %1 is not in the course templates directory and cannot be "
"deleted!"
msgstr "Το προσωρινό αρχείο %1 δεν είναι στον κατάλογο προτύπων του μαθήματος και δεν μπορεί να διαγραφεί!"

#. ($setVersionID)
#: /opt/webwork/webwork2/templates/ContentGenerator/GatewayQuiz.html.ep:354
msgid "The test (which is version %1) may no longer be submitted for a grade."
msgstr "Το διαγώνισμα (το οποίο είναι έκδοση %1) δεν μπορεί πλέον να υποβληθεί για βαθμολόγηση."

#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/Instructor/PGProblemEditor.pm:1122
msgid ""
"The text box now contains the source of the original problem. You can "
"recover lost edits by using the Back button on your browser."
msgstr ""
"Το πλαίσιο κειμένου περιέχει τώρα την πηγή του αρχικού προβλήματος. Μπορείτε "
"να ανακτήσετε τις χαμένες επεξεργασίες χρησιμοποιώντας το κουμπί \"Πίσω\" "
"στο πρόγραμμα περιήγησης."

#. (				% . 'but the result will not be counted.')
#: /opt/webwork/webwork2/templates/ContentGenerator/LoginProctor.html.ep:23
msgid ""
"The time limit on this assignment was exceeded. The assignment may be "
"checked, "
msgstr "Το χρονικό όριο σε αυτή την ανάθεση ξεπεράστηκε. Η ανάθεση μπορεί να ελεγχθεί, "

#: /opt/webwork/webwork2/lib/WeBWorK/ConfigValues.pm:244
msgid ""
"The time of the day that the assignment is due. This can be changed on an "
"individual basis, but WeBWorK will use this value for default when a set is "
"created."
msgstr "Η ώρα της ημέρας κατά την οποία λήγει η ανάθεση. Αυτό μπορεί να αλλαχθεί σε ατομική βάση, αλλά το WeBWorK θα χρησιμοποιήσει αυτή την τιμή ως προεπιλογή όταν δημιουργείται ένα σύνολο ασκήσεων."

#: /opt/webwork/webwork2/templates/HelpFiles/InstructorJobManager.html.ep:26
msgid ""
"The time that execution of the job begins. If execution of the job has not "
"started, then this will be empty."
msgstr "Ο χρόνος κατά τον οποίο ξεκινά η εκτέλεση της εργασίας. Εάν η εκτέλεση της εργασίας δεν έχει ξεκινήσει, τότε αυτό θα είναι κενό."

#: /opt/webwork/webwork2/templates/HelpFiles/InstructorJobManager.html.ep:31
msgid ""
"The time that execution of the job completes. If execution of the job has "
"not yet completed, then this will be empty."
msgstr "Ο χρόνος κατά τον οποίο ολοκληρώνεται η εκτέλεση της εργασίας. Εάν η εκτέλεση της εργασίας δεν έχει ολοκληρωθεί ακόμα, τότε αυτό θα είναι κενό."

#: /opt/webwork/webwork2/templates/HelpFiles/InstructorJobManager.html.ep:22
msgid "The time that the job was added to the queue."
msgstr "Ο χρόνος κατά τον οποίο η εργασία προστέθηκε στην ουρά."

#. ($rename_oldCourseID, $rename_oldCourseTitle, $rename_newCourseTitle)
#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/CourseAdmin.pm:656
msgid "The title of the course %1 has been changed from %2 to %3"
msgstr "Ο τίτλος του μαθήματος %1 έχει αλλάξει από %2 σε %3"

#. ($rename_newCourseID, $optional_arguments{courseTitle})
#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/CourseAdmin.pm:689
msgid "The title of the course %1 is now %2"
