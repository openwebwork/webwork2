msgid "Increase the number of versions from %1 to %2 for this test."
msgstr "A verziók számának növelése %1-ról %2-ra ehhez a teszthez."

#: /opt/webwork/webwork2/lib/WeBWorK/AchievementItems/HalfCreditProb.pm:13
msgid "Increases the grade of a single problem by 50%, to a maximum of 100%."
msgstr "Egy egyszeres feladat osztályzatát 50%-kal növeli, legfeljebb 100%-ig."

#: /opt/webwork/webwork2/lib/WeBWorK/AchievementItems/HalfCreditSet.pm:13
msgid ""
"Increases the score of every problem in an assignment by 50%, to a maximum "
"of 100%."
msgstr "Egy feladatsor minden feladatának pontszámát 50%-kal növeli, legfeljebb 100%-ig."

#: /opt/webwork/webwork2/lib/WeBWorK/ContentGenerator/PODViewer.pm:86
msgid "Index"
msgstr "Index"

#: /opt/webwork/webwork2/lib/WeBWorK/ConfigValues.pm:610
msgid "Indicate each date overriding an assignment date"
msgstr "Jelezzen minden dátumot, amely felülbírálja egy feladatsor dátumát"

#: /opt/webwork/webwork2/templates/HelpFiles/InstructorProblemSetList.html.ep:11
msgid ""
"Indicates the number of problems in the set. Clicking on the link opens the "
"set detail page which allows you to modify set parameters, edit set headers, "
"and change parameters of problems in the set such as the number of allowed "
"attempts or the weight (credit value). You can also add, remove, view, edit, "
"and reorder the problems in the set."
