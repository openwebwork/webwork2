msgid "Illegal file \"%1\" specified"
msgstr "Érvénytelen \"%1\" állomány lett megadva"

#: /opt/webwork/webwork2/lib/WeBWorK/File/SetDef.pm:627
msgid "Illegal filename contains '..'"
msgstr "Az érvénytelen állománynév '..'-t tartalmaz"

