% use WeBWorK::Utils qw(getAssetURL);
%
% content_for js => begin
	<%= javascript getAssetURL($ce, 'js/CourseAdmin/manage_locations.js'), defer => undef =%>
% end
%
<h2><%= maketext('Manage Locations') %> <%= $c->helpMacro('AdminManageLocations') %></h2>
<p><strong><%= maketext('Currently defined locations are listed below.') %></strong></p>
<%= form_for current_route, method => 'POST', id => 'manage-locations-form', begin =%>
	% my @locationIDs = map { $_->location_id } @$locations;
	%
	<%= $c->hidden_authen_fields =%>
	<%= $c->hidden_fields('subDisplay') =%>
	%
	<div class="col-lg-8 col-md-9">
		<div class="mb-2 fw-bold"><%= maketext('Select an action to perform:') =%></div>
		% # Edit action
		<div class="row align-items-center mb-2">
			<div class="col-sm-4">
				<div class="form-check">
					<label class="form-check-label">
						<%= radio_button
							manage_location_action => 'edit_location_form',
							class                  => 'form-check-input',
							@locationIDs ? () : (disabled => undef) %>
						<%= maketext('Edit Location:') %>
					</label>
				</div>
			</div>
			<div class="col-sm-8">
				<%= select_field
					edit_location => [@locationIDs],
					class         => 'form-select',
					@locationIDs ? () : (disabled => undef) =%>
			</div>
		</div>
		% # Create action
		<div class="row align-items-center mb-2">
			<div class="col-auto">
				<div class="form-check">
					<label class="form-check-label">
						<%= radio_button
							manage_location_action => 'add_location_handler',
							id                     => 'add_location_action',
							class                  => 'form-check-input' %>
						<%= maketext('Create Location:') %>
					</label>
				</div>
			</div>
		</div>
		<div class="row ms-sm-3 mb-2">
			<%= label_for new_location_name => maketext('Location name:'), class => 'col-sm-4 col-form-label' =%>
			<div class="col-sm-8">
				<%= text_field new_location_name => '', id => 'new_location_name', class => 'form-control' =%>
			</div>
		</div>
		<div class="row ms-sm-3 mb-2">
			<%= label_for
				new_location_description => maketext('Location description:'),
				class                    => 'col-sm-4 col-form-label' =%>
			<div class="col-sm-8">
				<%= text_field
					new_location_description => '',
					id                       => 'new_location_description',
					class                    => 'form-control' =%>
			</div>
		</div>
		<div class="row ms-sm-3 mb-2">
			<div class="col">
				<%= label_for new_location_addresses => maketext(
					'Addresses for new location.  Enter one per line, as single IP addresses (e.g., 192.168.1.101), '
						. 'address masks (e.g., 192.168.1.0/24), or IP ranges (e.g., 192.168.1.101-192.168.1.150):') =%>
			</div>
		</div>
		<div class="row ms-sm-3 mb-2">
			<div class="col-7 col-xs-12">
				<%= text_area
					new_location_addresses => '',
					id                     => 'new_location_addresses',
					columns                => 40,
					class                  => 'form-control' =%>
			</div>
		</div>
		<div class="row ms-sm-3 mb-2 d-none" id="create_location_err_msg">
			<div class="col">
				<div role="alert" class="alert alert-danger p-1 mb-0 d-inline-block">
					<%= maketext('Please provide a location name, description, and at least one address.') %>
				</div>
			</div>
		</div>
		% # Delete action
		<div class="row mb-2">
			<div class="text-danger">
				<em>
					<%= maketext('Deletion deletes all location data and related addresses, and is not undoable!') %>
				</em>
			</div>
		</div>
		<div class="row align-items-center mb-2">
			<div class="col-sm-4">
				<div class="form-check">
					<label class="form-check-label">
						<%= radio_button
							manage_location_action => 'delete_location_handler',
							id                     => 'delete_location_action',
							class                  => 'form-check-input' %>
						<%= maketext('Delete location:') %>
					</label>
				</div>
			</div>
			<div class="col-sm-8">
				<%= select_field
					delete_location =>
					[ [ maketext('locations selected below') => 'selected_locations' ], @locationIDs ],
					id    => 'delete_location_select',
					class => 'form-select' =%>
				<div id="select_location_err_msg" role="alert" class="alert alert-danger p-1 mt-2 mb-0 d-none">
					<%= maketext('Please select at least one location to delete.') %>
				</div>
			</div>
		</div>
	</div>
	<div
		class="modal fade"
		id="delete_location_confirm_dialog"
		tabindex="-1"
		aria-labelledby="delete_location_confirm_dialog_title"
		aria-hidden="true"
	>
		<div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
			<div class="modal-content">
				<div class="modal-header">
					<h1 class="modal-title fs-5" id="delete_location_confirm_dialog_title">
						<%= maketext('Delete Locations') =%>
					</h1>
					<button
						type="button"
						class="btn-close"
						data-bs-dismiss="modal"
						aria-label="<%= maketext('close') %>"
					></button>
				</div>
				<div class="modal-body">
					<div class="alert alert-danger p-1 mb-2">
						<%=
							maketext('Deletion deletes all location data and related addresses, and is not undoable!')
						=%>
					</div>
					<p class="mb-1"><%= maketext('The following locations will be permanently deleted:') =%></p>
					<ul id="delete_location_confirm_list" class="mb-0"></ul>
				</div>
				<div class="modal-footer">
					<button type="button" id="delete_location_confirm_proceed" class="btn btn-primary">
						<%= maketext('Delete') =%>
					</button>
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
						<%= maketext('Cancel') =%>
					</button>
				</div>
			</div>
		</div>
	</div>
	%
	<div><%= submit_button maketext('Take Action!'), name => 'manage_locations', class => 'btn btn-primary' =%></div>
	<div id="select_action_err_msg" role="alert" class="alert alert-danger p-1 mt-2 mb-0 d-inline-block d-none">
		<%= maketext('Please select an action to perform.') %>
	</div>
	%
	% # Existing location table
	% if (@$locations) {
		<div class="table-responsive mt-3">
			<table class="table table-sm font-sm table-bordered table-striped">
				<thead>
					<tr>
						<th><%= maketext('Select') %></th>
						<th><%= maketext('Location') %></th>
						<th><%= maketext('Description') %></th>
						<th><%= maketext('Addresses') %></th>
					</tr>
				</thead>
				<tbody class="table-group-divider">
					% for (@$locations) {
						<tr>
							<td>
								<%= check_box
									delete_selected => $_->location_id,
									name            => 'delete_selected',
									id              => $_->location_id . '_id',
									class           => 'form-check-input' =%>
							</td>
							<td>
								<%= label_for $_->location_id
									. '_id' => link_to $_->location_id => $c->systemLink(
										url_for,
										params => {
											subDisplay             => 'manage_locations',
											manage_location_action => 'edit_location_form',
											edit_location          => $_->location_id
										}
									) =%>
							</td>
							<td><%= $_->description %></td>
							<td><%= join(', ', @{ $locAddr->{ $_->location_id } }) %></td>
						</tr>
					% }
				</tbody>
			</table>
		</div>
	% } else {
		<div class="row mt-3">
			<div class="col-lg-8 col-md-9 fw-bold"><%= maketext('No locations are currently defined.') %></div>
		</div>
	% }
<% end =%>
