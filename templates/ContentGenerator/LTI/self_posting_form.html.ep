% use WeBWorK::Utils qw(getAssetURL);
%
<%= javascript getAssetURL($ce, 'js/LTILogin/ltilogin.js'), defer => undef =%>
<%= form_for $form_target,
	method  => 'POST',
	enctype => 'application/x-www-form-urlencoded',
	name    => 'ltiRepost',
	id      => 'ltiRepost',
	begin =%>
	% for (keys %$form_params) {
		<%= hidden_field $_ => $form_params->{$_} =%>
	% }
<% end =%>
