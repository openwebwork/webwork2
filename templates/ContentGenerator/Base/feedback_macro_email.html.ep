<%= form_for 'feedback', method => 'POST', begin %>
% my $includeScreenshot = $ce->{mail}{feedbackScreenshot} && $params->{problem};
<%= form_for 'feedback',
	method => 'POST',
	$includeScreenshot ? (data => { screenshot_max_size => $ce->{mail}{maxAttachmentSize} * 1000000 }) : (),
	begin %>
	<%= $c->hidden_authen_fields =%>
	% while (my ($key, $value) = each %$params) {
		% next if $key eq 'pg_object';    # Not used in internal feedback mechanism
		<%= hidden_field $key => $value =%>
	% }
	% # This is set to a screenshot of the problem by javascript.
	% if ($includeScreenshot) {
		<%= hidden_field screenshot => '' =%>
	% }
	<%= submit_button maketext($ce->{feedback_button_name}) || maketext('Email instructor'),
		name  => 'feedbackForm',
		class => 'btn btn-primary' =%>
% end
