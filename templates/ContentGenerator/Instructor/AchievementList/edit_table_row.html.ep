% use WeBWorK::Utils::Achievements qw(getAchievementAssetPaths);
%
% # Message for evaluator and icon filenames.
% my $message = '';
% if ($fieldName =~ /\.(test|icon)$/) {
	% my $type = $1;
	% my ($coursePath, $systemPath) = getAchievementAssetPaths($ce, $type, $value);
	% # Don't give a warning for an empty icon, since the default icon is used in that case.
	% if (!$coursePath && !$systemPath && ($type ne 'icon' || $value)) {
		% $message = maketext('Filename does not exist or is unsafe.');
	% } elsif ($coursePath && $systemPath) {
		% $message = maketext('Course file overrides system default.');
	% }
% }
%
% if ($fieldName =~ /\.enabled$/) {
	% # If the "enabled" checkbox is checked it returns a 1, if it is unchecked it returns nothing
	% # in which case the hidden field overrides the parameter with a 0.
	<%= check_box
		$fieldName        => 1,
		'aria-labelledby' => ($fieldName =~ s/^.*\.([^.]*)$/$1/r) . '_header',
		class             => 'form-check-input fs-5',
		$value ? (checked => undef) : () =%>
	<%= hidden_field $fieldName => 0 =%>
% } elsif ($fieldName =~ /\.assignment_type$/) {
	% my @allowedTypes = split(',', $value);
	% for my $type ([ default => 'homework' ], [ gateway => 'tests' ], [ jitar => 'just-in-time' ]) {
		<label class="form-check-label me-1">
			<%= $type->[1] =%>
			<%= check_box
				$fieldName => $type->[0],
				class      => 'form-check-input me-1',
				(grep { $type->[0] eq $_ } @allowedTypes) ? (checked => undef) : () =%>
		</label>
	% }
% } elsif ($fieldName =~ /\.achievement_id$/) {
	<%= $value =%>
% } elsif ($message) {
	<div class="input-group">
		<a
			class="set-id-tooltip px-1"
			role="button"
			tabindex="0"
			data-bs-placement="top"
			data-bs-toggle="tooltip"
			data-bs-title="<%= $message %>"
		>
			<i class="icon fas fa-circle-info mt-2" aria-hidden="true"></i>
			<span class="visually-hidden"><%= maketext('Achievement filename information.') %></span>
		</a>
		<%= text_field
			$fieldName        => $value,
			id                => $fieldName,
			'aria-labelledby' => ($fieldName =~ s/^.*\.([^.]*)$/$1/r) . '_header',
			size              => $size,
			class             => 'form-control form-control-sm rounded-1' =%>
	</div>
% } else {
	<%= text_field
		$fieldName        => $value,
		'aria-labelledby' => ($fieldName =~ s/^.*\.([^.]*)$/$1/r) . '_header',
		size              => $size,
		class             => 'form-control form-control-sm',
		$fieldName =~ /\.(test|icon)$/ ? (id => $fieldName) : () =%>
% }
