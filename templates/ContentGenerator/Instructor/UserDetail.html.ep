% use WeBWorK::Utils qw(getAssetURL);
%
% content_for css => begin
	<%= stylesheet getAssetURL($ce, 'node_modules/flatpickr/dist/flatpickr.min.css') =%>
	<%= stylesheet getAssetURL($ce, 'node_modules/flatpickr/dist/themes/dark.css'), id => 'flatpickr-dark-theme' =%>
	<%= stylesheet getAssetURL($ce, 'node_modules/flatpickr/dist/plugins/confirmDate/confirmDate.css') =%>
% end
%
% content_for js => begin
	<%= javascript getAssetURL($ce, 'node_modules/luxon/build/global/luxon.min.js'), defer => undef =%>
	<%= javascript getAssetURL($ce, 'node_modules/flatpickr/dist/flatpickr.min.js'), defer => undef =%>
	% if ($ce->{language} !~ /^en/) {
		<%= javascript getAssetURL(
			$ce,
			'node_modules/flatpickr/dist/l10n/'
				. ($ce->{language} =~ /^el/ ? 'gr' : ($ce->{language} =~ s/^(..).*/$1/gr)) . '.js'
			),
			defer => undef =%>
	% }
	<%=
		javascript getAssetURL($ce, 'node_modules/flatpickr/dist/plugins/confirmDate/confirmDate.js'), defer => undef
	=%>
	<%= javascript getAssetURL($ce, 'node_modules/shortcut-buttons-flatpickr/dist/shortcut-buttons-flatpickr.min.js'),
		defer => undef =%>
	<%= javascript getAssetURL($ce, 'js/DatePicker/datepicker.js'), defer => undef =%>
	%
	% # Add javascript specifically for this module.
	<%= javascript getAssetURL($ce, 'js/UserDetail/userdetail.js'), defer => undef =%>
% end
%
% unless ($authz->hasPermissions(param('user'), 'access_instructor_tools')) {
	<div class="alert alert-danger p-1">
		<%= maketext('You are not authorized to edit user specific information.') =%>
	</div>
	% last;
% }
%
% unless ($c->{userRecord}) {
	<div class="alert alert-danger p-1"><%= maketext('User [_1] not found.', $userID) %></div>
	% last;
% }
%
% my @editForSets = param('editForSets');
%
% my $userName = $c->{userRecord}->first_name . ' ' . $c->{userRecord}->last_name;
%
% # Display a message about how many sets have been assigned to this user.
% my $numberSets         = scalar(@{ $c->{setRecords} });
% my $numberAssignedSets = scalar(keys %{ $c->{userSetRecords} });
<div class="my-2">
	<p class="fw-bold">
		<%= maketext('[_1] ([_2]) is assigned to [_3] out of [_4] total sets.',
			$userName, $userID, $numberAssignedSets, $numberSets) =%>
	</p>
	<%= link_to(
		maketext(q/Edit [_1]'s user information/, $userName) => $c->systemLink(
			url_for('instructor_user_list'), params => { visible_users => $userID, editMode => 1 }
		),
		class => 'btn btn-primary'
	) =%>
</div>
%
<%= form_for current_route, method => 'post', name => 'UserDetail', id => 'UserDetail', begin =%>
	<%= $c->hidden_authen_fields =%>
	<%= hidden_field 'allow_unassign' => '' =%>
	%
	% if ($numberSets != $numberAssignedSets) {
		% # Add a hidden submit button so hitting "Enter" will "Save changes" instead of assigning all sets.
		<%= submit_button maketext('Save changes'),
			name          => 'save_button',
			class         => 'visually-hidden',
			tabindex      => -1,
			'aria-hidden' => 'true' =%>
		<div class="mb-2">
			<%= submit_button maketext('Assign all sets to [_1]', $userName),
				name  => 'assignAll',
				class => 'btn btn-primary' =%>
		</div>
	% }
	<p class="mb-2">
		<%= maketext(
			'To change status (scores or grades) for this student for one set, click on the individual set link.') =%>
	</p>
	<p class="mb-2">
		<%= maketext('Unchecking the "Assigned" checkbox will unassign the set from this student, and destroy '
				. 'all user data for that set. This cannot be undone.') =%>
	</p>
	%
	<div class="mb-2">
		<%= submit_button maketext('Save changes'), name => 'save_button', class => 'btn btn-primary' =%>
	</div>
	%
	<div class="table-responsive">
		<table class="table table-bordered table-sm font-sm align-middle w-auto caption-top">
			<caption>
				<%= maketext('Available Sets') =%>
			</caption>
			<tr>
				<th class="text-center"><%= maketext('Assignment') %></th>
				<th class="text-center"><%= maketext('Assigned') %></th>
				<th class="text-center"><%= maketext('Dates') %></th>
			</tr>
			% for my $set (@{ $c->{setRecords} }) {
				% my $setID = $set->set_id;
				%
				<%= include 'ContentGenerator/Instructor/UserDetail/set_row',
					set       => $set,
					userSet   => $c->{userSetRecords}{$setID},
					mergedSet => $c->{mergedSetRecords}{$setID} =%>
				%
				% if ($set->assignment_type =~ /gateway/) {
					% for (0 .. $#{ $c->{setVersions}{$setID} }) {
						<%= include 'ContentGenerator/Instructor/UserDetail/set_row',
							set       => $set,
							userSet   => $c->{setVersions}{$setID}[$_],
							mergedSet => $c->{mergedVersions}{$setID}[$_],
							version   => $c->{setVersions}{$setID}[$_]->version_id =%>
					% }
				% }
			% }
		</table>
	</div>
	<div
		class="modal fade"
		id="unassign_confirm_dialog"
		tabindex="-1"
		aria-labelledby="unassign_confirm_dialog_title"
		aria-hidden="true"
	>
		<div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
			<div class="modal-content">
				<div class="modal-header">
					<h1 class="modal-title fs-5" id="unassign_confirm_dialog_title">
						<%= maketext('Unassign sets from [_1]', $userName) =%>
					</h1>
					<button
						type="button"
						class="btn-close"
						data-bs-dismiss="modal"
						aria-label="<%= maketext('close') %>"
					></button>
				</div>
				<div class="modal-body">
					<div class="alert alert-danger p-1 mb-2">
						<%= maketext('Warning: Unassigning sets will destroy all user data for that set '
								. 'and cannot be undone!') =%>
					</div>
					<p class="mb-1">
						<%= maketext('Unassign the following sets from [_1]:', $userName) =%>
					</p>
					<ul id="unassign_confirm_set_list" class="mb-2"></ul>
				</div>
				<div class="modal-footer">
					<button type="button" id="unassign_confirm_proceed" class="btn btn-primary">
						<%= maketext('Unassign') =%>
					</button>
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
						<%= maketext('Cancel') =%>
					</button>
				</div>
			</div>
		</div>
	</div>
	%
	<%= submit_button maketext('Save changes'), name => 'save_button', class => 'btn btn-primary' =%>
<% end =%>
