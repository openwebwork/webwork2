% use WeBWorK::Utils::Files qw(listFilesRecursive);
%
% my @notifications = sort(listFilesRecursive($ce->{courseDirs}{achievement_notifications}, qr/\.epl?$/));
% last unless @notifications;
<div class="row align-items-center mb-2">
	<%= label_for
		'action.existing.target_file_id' => maketext('Use existing template:'),
		class                            => 'col-form-label col-auto' =%>
	<div class="col-auto">
		<%= select_field
			'action.existing.target_file' => [
				map { [
					$_ =~ s/(\.html|\.txt)?\.epl?//r => $_,
					$_ eq $c->{sourceFile} ? (selected => undef) : ()
				] } @notifications
			],
			id    => 'action.existing.target_file_id',
			class => 'form-select form-select-sm d-inline w-auto',
			dir   => 'ltr' =%>
	</div>
</div>
