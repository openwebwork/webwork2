<div>
	<div class="row align-items-center mb-2">
		<%= label_for 'action.save_as.target_file_id' => maketext('Save as:'), class => 'col-form-label col-auto' =%>
		<div class="col-auto d-inline-flex" dir="ltr">
			<div class="editor-save-path input-group input-group-sm">
				<span class="input-group-text">[ACHEVNOTIFYDIR]/</span>
				<%= text_field
					'action.save_as.target_file' => $c->{sourceFile},
					id                           => 'action.save_as.target_file_id',
					size                         => 40,
					class                        => 'form-control form-control-sm',
					dir                          => 'ltr',
					data                         => { original_name => $c->{sourceFile} } =%>
			</div>
		</div>
	</div>
	<div id="blank_filename_err_msg" role="alert" class="alert alert-danger p-1 d-inline-flex d-none">
		<%= maketext('Please enter a new achievement notification template filename.') %>
	</div>
	<div id="change_filename_err_msg" role="alert" class="alert alert-danger p-1 d-inline-flex d-none">
		<%= maketext('Please choose a different filename for new template.') %>
	</div>
	<div id="invalid_filename_err_msg" role="alert" class="alert alert-danger p-1 d-inline-flex d-none">
		<%= maketext('Filenames cannot contain a slash, "/".') %>
	</div>
</div>
